# Local development only. Never commit a real .env file.
APP_ENV=local
APP__LOGGING__LEVEL=DEBUG

# Use fake for local development without third-party calls.
APP__LLM__PROVIDER=fake
APP__LLM__MODEL=fake-model

# If you switch to the Anthropic provider locally:
# APP__LLM__PROVIDER=anthropic
# APP__LLM__MODEL=claude-opus-5-5
# LLM_ANTHROPIC_API_KEY=sk-ant-replace-me

# If you switch to an OpenAI-compatible provider locally:
# APP__LLM__PROVIDER=openai_compat
# APP__LLM__MODEL=your-model
# APP__LLM__BASE_URL=https://api.example.com/v1
# APP__LLM__API_KEY_REF=secret://llm/openai_api_key
# LLM_OPENAI_API_KEY=replace-me

# Optional: Redis-backed rate limit / quota / idempotency for staging/prod.
# APP__REDIS__ENABLED=true
# APP__REDIS__URL=redis://localhost:6379/0
